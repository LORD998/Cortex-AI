# Modelos locais
CORTEX_MODEL=qwen3:8b
CORTEX_VISION_MODEL=qwen3-vl:8b
CORTEX_OLLAMA_URL=http://localhost:11434
CORTEX_CONTEXT_SIZE=8192

# Agente
CORTEX_MAX_AGENT_STEPS=6
CORTEX_MAX_TOOLS=18
CORTEX_MAX_HISTORY=24
CORTEX_REASONING=auto
CORTEX_LOCAL_ONLY=true
CORTEX_LANGUAGE=pt-BR

# Voz e tradução local
# "small" equilibra qualidade e velocidade; "medium" melhora idiomas, mas usa mais recursos.
CORTEX_WHISPER_MODEL=small
# auto tenta a RTX e muda automaticamente para CPU se faltarem bibliotecas CUDA.
CORTEX_WHISPER_DEVICE=auto
# Kokoro pf_dora é uma voz feminina brasileira. Piper fica disponível como alternativa.
CORTEX_TTS_ENGINE=kokoro
CORTEX_TTS_SPEED=1.0
CORTEX_TTS_VOICE_PT=pf_dora:0.72,af_heart:0.28
CORTEX_TTS_VOICE_EN=af_heart
# Idioma em que a tua voz será reproduzida para a outra pessoa.
CORTEX_TRANSLATOR_TARGET=en

# Gmail (opcional; e-mail exige Internet mesmo com o cérebro local)
# CORTEX_GMAIL_CREDENTIALS=C:\Users\teu-utilizador\AppData\Roaming\Cortex\gmail_credentials.json
